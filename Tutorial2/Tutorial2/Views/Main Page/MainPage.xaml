<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tutorial2.MainPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto" RowSpacing="0">

            <VerticalStackLayout Spacing="16" Grid.Row="0">
                <Label Text="Mandy Siaw Zhi Lei BCS23090059"
                       Style="{StaticResource SubHeadline}"
                       TextColor="{StaticResource Gray900}"
                       Margin="0,24,0,0" />

                <Image Source="golden.jpg"
                       HeightRequest="350"
                       Aspect="AspectFill" />

                <BoxView HeightRequest="450" />
            </VerticalStackLayout>

            <Border BackgroundColor="#FFFBF0"
                    StrokeShape="RoundRectangle 24"
                    Padding="24"
                    Margin="16, 280, 16, 16" 
                    VerticalOptions="Start"
                    Grid.Row="0">

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,10"
                            Radius="20"
                            Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Robin Hood"
                                   FontSize="24"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="Black" />
                            <Label Text="Golden Retriever"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                            <Label Text="1 year old"
                                   TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="3B, Lorong 88, Taman Rantau Panjang, 96000 Sibu, Sarawak"
                               TextColor="{StaticResource Gray500}"
                               FontSize="14" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,8" />

                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                               Source="teolaegi.jpg"
                               HeightRequest="50"
                               WidthRequest="50"
                               Aspect="AspectFill">
                            <Image.Clip>
                                <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25" />
                            </Image.Clip>
                        </Image>

                        <Label Grid.Row="0" Grid.Column="1"
                               Text="Baekhyun"
                               FontFamily="OpenSansSemibold"
                               TextColor="Black"
                               VerticalOptions="End" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="Owner"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Start" />

                        <Label Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                               Text="1.11.2024"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Hi! Robin the Golden is simply a tiny tornado of fur, wrinkles, and endless charm!"
                           TextColor="Black"
                           Margin="0,8" />

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" Margin="0,8,0,0">
                        <Border Grid.Column="0"
                                Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="50"
                                WidthRequest="50">
                            <Label Text="♡"
                                   FontSize="24"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Button Grid.Column="1"
                                Text="Adoption"
                                BackgroundColor="#F5C64A"
                                TextColor="Black"
                                FontFamily="OpenSansSemibold"
                                CornerRadius="25"
                                HeightRequest="50" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>